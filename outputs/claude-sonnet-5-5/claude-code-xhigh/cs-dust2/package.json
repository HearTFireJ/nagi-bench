{
  "name": "dust2-fps",
  "private": true,
  "version": "1.0.0",
  "description": "Dust2 5v5 first-person shooter prototype - React + TypeScript + three.js, zero external assets",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:sim && npm run test:smoke",
    "test:sim": "node --experimental-strip-types scripts/sim-test.ts",
    "test:smoke": "node --experimental-strip-types --import ./scripts/smoke/register.mjs scripts/smoke/render-smoke.ts",
    "sim:ascii": "node --experimental-strip-types scripts/ascii-map.ts",
    "sim:match": "node --experimental-strip-types scripts/match-sim.ts",
    "sim:balance": "node --experimental-strip-types scripts/balance.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
